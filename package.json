{
  "name": "tundrabot",
  "version": "3.0.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.12.0"
  },
  "description": "",
  "main": "TundraBot.ts",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env --enable-source-maps ./dist/TundraBot.cjs | pnpm pino-pretty",
    "build": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run build:esbuild",
    "build:esbuild": "node ./esbuild.ts",
    "db:generate": "pnpm drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./src/db/migrate.ts | pnpm pino-pretty",
    "deploy:guild": "node --env-file=.env --enable-source-maps ./dist/deployCommands.cjs",
    "deploy:deleteGuild": "node --env-file=.env --enable-source-maps ./dist/deleteAllCommands.cjs",
    "dev": "node --watch ./src/TundraBot.ts | pnpm pino-pretty",
    "format": "pnpm prettier . --write",
    "lint": "pnpm eslint ./src ./tests --fix",
    "prepare": "husky",
    "test": "pnpm run test:unit",
    "test:unit": "jest",
    "typecheck": "pnpm tsc --noEmit"
  },
  "lint-staged": {
    "*": [
      "pnpm prettier . --write",
      "pnpm eslint . --fix"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshuayuen99/tundrabot.git"
  },
  "author": "Joshua Yuen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/joshuayuen99/tundrabot/issues"
  },
  "homepage": "https://github.com/joshuayuen99/tundrabot#readme",
  "dependencies": {
    "discord.js": "^14.25.1",
    "drizzle-orm": "1.0.0-beta.20",
    "pg": "^8.20.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@jest/globals": "^30.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.15.24",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^11.13.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/node-ts": "^23.6.4",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/parser": "^8.57.2",
    "drizzle-kit": "1.0.0-beta.20",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tiny-glob": "^0.2.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2"
  }
}
