{
  "name": "tundrabot",
  "version": "3.0.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.12.0"
  },
  "description": "",
  "main": "TundraBot.ts",
  "type": "module",
  "scripts": {
    "start": "node --enable-source-maps ./dist/TundraBot.cjs",
    "build": "pnpm run lint && pnpm run typecheck && pnpm esbuild ./src/TundraBot.ts --outdir=dist --out-extension:.js=.cjs --bundle --sourcemap --platform=node --format=cjs",
    "dev": "node --watch ./src/TundraBot.ts",
    "lint": "pnpm eslint ./src --fix",
    "typecheck": "pnpm tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshuayuen99/tundrabot.git"
  },
  "author": "Joshua Yuen",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/joshuayuen99/tundrabot/issues"
  },
  "homepage": "https://github.com/joshuayuen99/tundrabot#readme",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/node-ts": "^23.6.4",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/parser": "^8.57.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2"
  }
}
